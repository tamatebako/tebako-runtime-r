# Boot smoke for a built tebako R runtime (tebako-runtime-php's
# boot_smoke role — stdlib-only, no rspec surface): boots the built exe
# against its sibling env image and asserts the driver contract end to
# end. Scenarios (POSIX — the windows materialize-tier set arrives with
# the windows leg):
#
#   bare                 no image: the driver NAMES the bare boot on
#                        stderr (TEBAKO_RUNTIME_IMAGE is not set). Like
#                        python — whose stdlib is image-resident — the R
#                        exe is NOT a working interpreter bare: exec/R
#                        locates its home from R_HOME and dies
#                        "Fatal error: R home directory is not defined"
#                        (exit 2, on STDOUT — R_Suicide's REprintf rides
#                        R's output console) when it is unset. The lone --version
#                        fast path (upstream Rscript semantics: it never
#                        touches R) still answers — the smoke pins both
#                        honest behaviors.
#   boot                 TEBAKO_RUNTIME_IMAGE handoff: `--version`
#                        answers, R.home() reports the mount root's
#                        lib/R (the fs TU exported R_HOME off the
#                        effective root), and the mounted env image is
#                        READABLE THROUGH the interpreter (the layout
#                        card exists at the mount root — proof the
#                        preload-shim re-exec serves the VFS, not the
#                        host). A summary() probe proves the interpreter
#                        computes, and capabilities("libcurl") proves the
#                        internet module carries the deps stage's static
#                        curl (no network probe — CI-network flakiness
#                        never enters the gate).
#   payload              --tebako-image <fixture>:-:/app +
#                        --tebako-entry /bin/hello.R <args> (the entry is
#                        an IN-IMAGE path — the driver joins it with the
#                        declared mount; the fs TU's Rscript front-end
#                        turns it into --file=): a script runs from the
#                        mounted payload and sees its trailing args via
#                        commandArgs(TRUE)
#   compute-floor        the boot probes are blind to a slow BUILD
#                        (tebako-runtime-python#79's lesson: a leg that
#                        computes at a fraction of the matrix's rate
#                        ships green under a boot-only gate): the pair
#                        runs a fixed pure-compute loop (an arithmetic
#                        loop, no I/O in it) timed INSIDE the interpreter
#                        (proc.time() per run, best of three — boot/mount
#                        cost and one-off scheduling noise are excluded),
#                        and the best run must land under a generous
#                        ceiling. The ceiling is a regression tripwire,
#                        never a benchmark. The flags arm is fail-closed:
#                        R records no CFLAGS at runtime, so the arm reads
#                        the build's own record — the sibling
#                        .contract.yaml's built_from.cflags (written from
#                        the generated Makeconf's CFLAGS —
#                        RBuild#recorded_cflags, itself gated at
#                        configure time) — plus the interpreter's own
#                        getRversion(). A mis-flagged build is a recipe
#                        bug, never the slow-silicon defect class. Modes
#                        (COMPUTE_FLOOR_MODE): "fail" (the default)
#                        trips the leg; "warn" — armed by the workflow on
#                        the macos-x86_64 leg ALONE, where the link-unit
#                        line carries the LIVE ~3x slow-compute defect on
#                        real Intel silicon (tebako#1095, still open) —
#                        prints a ::warning:: and keeps the leg green.
#                        REMOVAL CONDITION: that leg reverts to
#                        fail-closed when tebako#1095 closes.      [all]
#   bad-mount            --tebako-image <missing>:-:/nope -> exit 69
#                        (the unavailable image, named on stderr)
#   mount-root-override  TEBAKO_MOUNT_ROOT=<abs>: boots, R.home() follows
#                        the override root, and the layout card reads at
#                        the OVERRIDE root (the image grants it)
#   mount-root-malformed TEBAKO_MOUNT_ROOT=relative/path -> exit 65
#   override-ungranted   TEBAKO_MOUNT_ROOT against an env image whose
#                        layout lacks the grant -> exit 78
#
# Usage:
#   tools/boot_smoke [--runtime-root DIR | --exe PATH] [--tfs PATH]
#                    [--scenario all|bare|boot|payload|compute-floor|
#                                bad-mount|mount-root-override|
#                                mount-root-malformed|override-ungranted]
#
# Exit codes: 0 green · 141 usage/resolution · 143 a scenario failed.

require "fileutils"
require "open3"
require "optparse"
require "tmpdir"
require "yaml"

REPO_ROOT = File.expand_path("..", __dir__).freeze
$LOAD_PATH.unshift(File.join(REPO_ROOT, "build", "lib"))

require "tebako_r_builder"

BOOT_TIMEOUT = 60
# The compute-floor scenario (the header's tebako-runtime-python#79
# block): a COMPUTE_LOOP_N-iteration arithmetic loop inner-timed, best of
# COMPUTE_RUNS. The ceiling carries several-x headroom over the healthy
# matrix's measured legs (an -O2 R leg measures ~0.5-1.0 s native for
# 1e7 scalar iterations; the unoptimized env-clobber class lands ~2-3x
# that) — a tripwire, never a benchmark bound.
COMPUTE_LOOP_N = 10_000_000
COMPUTE_RUNS = 3
COMPUTE_FLOOR_SECONDS = 10.0
IMAGE_SUFFIXES = %w[.tfs .dwarfs].freeze
MARKER_SUFFIXES = %w[.abi .sha256 .origin .yaml .dll].freeze
NON_EXECUTABLE_SUFFIXES = (IMAGE_SUFFIXES + MARKER_SUFFIXES).freeze

# The child env is REPLACED, not inherited: any tebako/preload leftovers
# a host setup would leak in are scrubbed (the ruby factory's msys
# GEM_HOME lesson). The R_* keys join them: a host R installation's
# R_HOME/R_LIBS would otherwise leak into the boot and mask the fs TU's
# own R_HOME export — the smoke must prove the runtime stands alone.
ENV_SCRUBBED = %w[
  LD_PRELOAD DYLD_INSERT_LIBRARIES DYLD_FALLBACK_LIBRARY_PATH
  R_HOME R_ARCH R_LIBS R_LIBS_USER R_LIBS_SITE
  R_DEFAULT_PACKAGES R_SCRIPT_DEFAULT_PACKAGES R_SCRIPT_LEGACY
  R_PROFILE R_PROFILE_USER R_ENVIRON R_ENVIRON_USER
].freeze

# The host platform, probed once.
BOOT_PLATFORM = TebakoRBuilder::Platform.new

def usage_error(message)
  warn "boot_smoke: #{message}"
  exit 141
end

# The compute-floor scenario's mode (its header block): "fail" — the
# default, and every leg's shape but one — trips the leg on a breached
# floor; "warn" prints the measurement + a workflow-command ::warning::
# and keeps the leg green. The workflow arms "warn" on the macos-x86_64
# leg ALONE: the live tebako#1095 slow-compute defect (the product
# repo's, in the link-unit line this factory pins) would otherwise red
# that leg until the fix ships. REMOVAL CONDITION: the leg reverts to
# fail-closed when tebako#1095 closes. Any other value is a named error,
# never a silent fallback.
COMPUTE_FLOOR_MODE = ENV.fetch("COMPUTE_FLOOR_MODE", "fail")
unless %w[fail warn].include?(COMPUTE_FLOOR_MODE)
  usage_error("COMPUTE_FLOOR_MODE=#{COMPUTE_FLOOR_MODE.inspect} — known: fail (the default), warn")
end

options = { runtime_root: ENV.fetch("TEBAKO_RUNTIME_ROOT", nil), exe: nil, tfs: nil, scenario: "all" }
parser = OptionParser.new do |opts|
  opts.banner = "Usage: tools/boot_smoke [options]"
  opts.on("--runtime-root DIR", "Directory holding exactly one tebako-runtime-* executable") do |v|
    options[:runtime_root] = v
  end
  opts.on("--exe PATH", "The runtime executable itself (wins over --runtime-root)") { |v| options[:exe] = v }
  opts.on("--tfs PATH", "tfs CLI for the fixture images (default: TEBAKO_TFS, then tfs on PATH)") do |v|
    options[:tfs] = v
  end
  opts.on("--scenario NAME", "One scenario to run (default: all)") { |v| options[:scenario] = v }
  opts.on("-h", "--help", "Print this help") do
    puts opts
    exit 0
  end
end
parser.parse!

platform = BOOT_PLATFORM

# --- artifact resolution ---------------------------------------------------

def resolve_executable(root, exe)
  return File.expand_path(exe) if exe && File.file?(exe)
  usage_error("--exe #{exe.inspect} is not a file") if exe
  usage_error("no --runtime-root/--exe (TEBAKO_RUNTIME_ROOT unset)") if root.to_s.empty? || !File.exist?(root)
  return File.expand_path(root) if File.file?(root)

  candidates = Dir.glob(File.join(root, "tebako-runtime-*"))
                  .select { |path| File.file?(path) && !NON_EXECUTABLE_SUFFIXES.include?(File.extname(path)) }
  usage_error("no tebako runtime executable under #{root}") if candidates.empty?
  usage_error("several runtime executables under #{root} (#{candidates.join(", ")})") if candidates.length > 1

  File.expand_path(candidates.first)
end

def resolve_tfs(requested)
  candidate = requested || ENV.fetch("TEBAKO_TFS", nil) || "tfs"
  return candidate if File.file?(candidate) && File.executable?(candidate)

  ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).each do |dir|
    path = File.join(dir, candidate)
    return path if File.file?(path) && File.executable?(path)
  end
  usage_error("no tfs CLI resolvable (#{candidate}) — the fixture-image scenarios need it " \
              "(--tfs / TEBAKO_TFS; tools/build_runtime already fetched one under .build)")
end

# --- scenario drivers ------------------------------------------------------

def boot(executable, argv, env_extra, timeout: BOOT_TIMEOUT)
  Dir.mktmpdir("tebako-r-boot-smoke") do |cwd|
    env = ENV_SCRUBBED.to_h { |key| [key, nil] }
    ENV.each_key { |key| env[key] = nil if key.start_with?("TEBAKO_") }
    env.merge!(env_extra)
    # popen3 + a wait-deadline poll, NOT Timeout.timeout around capture3:
    # the Timeout unwind lands in popen3's ensure (wait_thr.join on the
    # still-immortal child) and blocks forever there, so the timeout
    # could never fire on a wedged runtime (the tebako#527 gnu shape:
    # zero output, never exits). Past the deadline the child is
    # hard-killed and reaped BEFORE any unwind touches popen3's ensure.
    out = err = status = nil
    Open3.popen3(env, executable, *argv, chdir: cwd) do |stdin, stdout, stderr, wait_thr|
      stdin.close
      readers = [stdout, stderr].map { |io| Thread.new { io.read } }
      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
      loop do
        break if wait_thr.join(0.1)
        next unless Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

        Process.kill("KILL", wait_thr.pid)
        wait_thr.join
        readers.each(&:kill)
        return ["", "boot_smoke: runtime did not exit within #{timeout}s (hard-killed)", nil]
      end
      out, err = readers.map(&:value)
      status = wait_thr.value
    end
    [out, err, status]
  end
end

$failures = 0
def check(name, ok, detail)
  if ok
    puts "ok   #{name}"
  else
    puts "FAIL #{name}: #{detail}"
    $failures += 1
  end
end

def expect_exit(name, out, err, status, code)
  check(name, status&.exitstatus == code,
        "expected exit #{code}, got #{status&.exitstatus.inspect}\nstdout: #{out}\nstderr: #{err}")
end

def expect_ok(name, out, err, status, marker)
  ok = status&.exitstatus&.zero? && out.include?(marker)
  check(name, ok, "expected exit 0 + #{marker.inspect}\nstdout: #{out}\nstderr: #{err}")
end

# The payload fixture: a script riding /app that reports its trailing
# args (commandArgs(TRUE) — proof the fs TU's Rscript front-end routed
# the entry to --file= and the rest past --args) and computes (summary).
def payload_fixture(tfs, dir)
  tree = File.join(dir, "payload-tree")
  FileUtils.mkdir_p(File.join(tree, "bin"))
  File.write(File.join(tree, "bin", "hello.R"), <<~R)
    cat("PAYLOAD-OK\n")
    cat("args:", paste(commandArgs(trailingOnly = TRUE), collapse = " "), "\n")
    print(summary(c(1, 2, 3)))
  R
  image = File.join(dir, "payload.tfs")
  out, st = Open3.capture2e(tfs, "mkimage", tree, "-o", image)
  usage_error("fixture image build failed: #{out}") unless st.exitstatus&.zero? && File.file?(image)

  image
end

# The ungranted env-image fixture: a layout card WITHOUT the
# mount_root_override grant (and no preload_shim — the override refusal
# must fire before any interpreter handoff).
def ungranted_fixture(tfs, dir, platform)
  tree = File.join(dir, "ungranted-tree")
  FileUtils.mkdir_p(File.join(tree, "lib", "tebako"))
  File.write(File.join(tree, "lib", "tebako", "layout.yaml"), <<~YAML)
    schema: layout
    schema_version: 1
    era: 2
    image_layout: 1
    mount_root: #{platform.mount_root}
    interpreter_api_version: "4.6"
  YAML
  image = File.join(dir, "ungranted.tfs")
  out, st = Open3.capture2e(tfs, "mkimage", tree, "-o", image)
  usage_error("ungranted fixture image build failed: #{out}") unless st.exitstatus&.zero? && File.file?(image)

  image
end

KNOWN_SCENARIOS = %w[bare boot payload compute-floor bad-mount mount-root-override
                     mount-root-malformed override-ungranted].freeze
# Scenarios that build images with the tfs CLI.
TFS_SCENARIOS = %w[payload override-ungranted].freeze

def selected_scenarios(only)
  return KNOWN_SCENARIOS.dup if only == "all"
  return [only] if KNOWN_SCENARIOS.include?(only)

  usage_error("unknown scenario '#{only}' (known: #{KNOWN_SCENARIOS.join(", ")})")
end

def run_scenarios(executable, platform, selected, tfs:)
  image = "#{executable.sub(/\.exe\z/, "")}.tfs"
  mount_root = platform.mount_root

  Dir.mktmpdir("tebako-r-smoke-fixtures") do |dir|
    selected.each do |scenario|
      case scenario
      when "bare"
        # The two-artifact model: what this scenario pins is the DRIVER's
        # half of the contract — it names the bare boot on stderr — and
        # R's honest behavior (the header): the --version fast path
        # answers without R, but the interpreter itself needs R_HOME and
        # names that failure when it is absent.
        out, err, st = boot(executable, ["--version"], {})
        check("bare: the driver names the bare boot",
              err.include?("TEBAKO_RUNTIME_IMAGE is not set"), "stderr: #{err}")
        check("bare: the --version fast path answers without R (upstream Rscript semantics)",
              st&.exitstatus&.zero? && out.include?("Rscript (R) version"), "stdout: #{out}\nstderr: #{err}")
        out, err, st = boot(executable, ["-e", "cat(1)"], {})
        check("bare: the interpreter names its missing R_HOME (exit 2, R's own message)",
              st&.exitstatus == 2 && out.include?("R home directory is not defined"),
              "exit: #{st&.exitstatus.inspect}\nstdout: #{out}\nstderr: #{err}")
      when "boot"
        unless File.file?(image)
          check("boot", false, "no sibling env image #{image}")
          next
        end
        out, err, st = boot(executable, ["--version"], { "TEBAKO_RUNTIME_IMAGE" => image })
        expect_ok("boot: --version answers off the pair", out, err, st, "Rscript (R) version")
        # The mounted-image proof: the layout card is served THROUGH the
        # interpreter's own libc IO (the preload shim's re-exec), never
        # from the host — the path exists only inside the image. R.home()
        # reports the fs TU's R_HOME export (the effective root's lib/R).
        probe = <<~R
          cat("BOOT-OK\\n")
          cat("home:", R.home(), "\\n")
          cat("card:", file.exists("#{mount_root}/lib/tebako/layout.yaml"), "\\n")
        R
        out, err, st = boot(executable, ["-e", probe], { "TEBAKO_RUNTIME_IMAGE" => image })
        expect_ok("boot: the mounted image is readable through the interpreter", out, err, st, "BOOT-OK")
        check("boot: R_HOME rides the mount root", out.include?("home: #{mount_root}/lib/R"),
              "stdout: #{out}\nstderr: #{err}")
        check("boot: the layout card rides the mount", out.include?("card: TRUE"),
              "stdout: #{out}\nstderr: #{err}")
        # The interpreter computes (the README's one-line smoke).
        out, err, st = boot(executable, ["-e", "print(summary(c(1, 2, 3)))"],
                            { "TEBAKO_RUNTIME_IMAGE" => image })
        expect_ok("boot: summary() computes off the mounted stdlib", out, err, st, "Mean")
        # The internet module carries libcurl (R 4.6 hard-requires it —
        # the deps stage's minimal static build is what satisfies it).
        # capabilities() is the interpreter's own record, never a
        # network probe, so CI-network flakiness never enters the gate
        # (end-to-end https from inside the runtime is the named manual
        # verification, docs/build-chain.md).
        out, err, st = boot(executable, ["-e", 'cat(capabilities("libcurl"))'],
                            { "TEBAKO_RUNTIME_IMAGE" => image })
        expect_ok("boot: the internet module carries libcurl", out, err, st, "TRUE")
        # LAPACK answers off the pair: solve() loads the dlopen'd lapack
        # module → libRlapack.so, whose one undefined gfortran reference
        # (_gfortran_concat_string) binds from the exe — the FLIBS pin's
        # binding partner. The provenance gate asserts the exe's export;
        # this proves the chain end to end.
        out, err, st = boot(executable, ["-e", "cat(sum(solve(matrix(c(2, 0, 0, 4), 2, 2))))"],
                            { "TEBAKO_RUNTIME_IMAGE" => image })
        expect_ok("boot: LAPACK computes (the dlopen'd module binds gfortran from the exe)", out, err, st, "0.75")
      when "payload"
        fixture = payload_fixture(tfs, dir)
        # The entry is an IN-IMAGE path (spec 17): the driver joins it
        # with the declared mount; the fs TU's front-end translates it to
        # --file=<vfs path> and the trailing args past --args.
        out, err, st = boot(executable,
                            ["--tebako-image", "#{fixture}:-:/app", "--tebako-entry", "/bin/hello.R", "alpha", "beta"],
                            { "TEBAKO_RUNTIME_IMAGE" => image })
        expect_ok("payload", out, err, st, "PAYLOAD-OK")
        check("payload: the trailing args arrive via commandArgs(TRUE)", out.include?("args: alpha beta"),
              "stdout: #{out}\nstderr: #{err}")
        check("payload: summary() computes from the mounted payload", out.include?("Mean"),
              "stdout: #{out}\nstderr: #{err}")
      when "compute-floor"
        unless File.file?(image)
          check("compute-floor", false, "no sibling env image #{image}")
          next
        end
        # The flags arm (the header block): fail-closed. R records no
        # CFLAGS at runtime, so the -O axis reads the build's own record
        # — the sibling .contract.yaml's built_from.cflags
        # (RBuild#recorded_cflags wrote it from the generated Makeconf,
        # and gated it at configure time); the version axis reads the
        # interpreter itself.
        out, err, st = boot(executable, ["-e", "cat(as.character(getRversion()))"],
                            { "TEBAKO_RUNTIME_IMAGE" => image })
        expect_ok("compute-floor: getRversion() answers off the pair", out, err, st, ".")
        card_path = "#{executable.sub(/\.exe\z/, "")}.contract.yaml"
        cflags = begin
          YAML.load_file(card_path).dig("built_from", "cflags").to_s
        rescue Errno::ENOENT, Psych::Exception
          ""
        end
        check("compute-floor: the build record pins -O2/-O3 (no -O0/-O1/-Og/-Od)",
              !cflags.empty? && (cflags.split & %w[-O0 -O1 -Og -Od]).empty? &&
                cflags.split.grep(/\A-O[23]\z/).any?,
              "#{card_path} records cflags #{cflags.empty? ? '(none — the card is missing or predates the cflags key)' : cflags.inspect} " \
              "— a mis-flagged build ships a slow interpreter green under a boot-only gate " \
              "(tebako-runtime-python#79's class)")
        # The timing arm: a fixed arithmetic loop — the covenant's
        # steady.cpu shape, no I/O in the loop — timed INSIDE the
        # interpreter (proc.time() around each run): the boot/mount cost
        # and the harness never enter the measurement, and best-of-N
        # drops one-off scheduling noise.
        compute_probe = <<~R
          runs <- numeric(#{COMPUTE_RUNS})
          for (i in seq_len(#{COMPUTE_RUNS})) {
            t0 <- proc.time()[["elapsed"]]
            x <- 0
            for (j in seq_len(#{COMPUTE_LOOP_N})) x <- x + j
            runs[i] <- proc.time()[["elapsed"]] - t0
          }
          cat("COMPUTE-FLOOR\\n")
          cat("runs:", sprintf("%.3f", runs), "\\n")
          cat("best:", sprintf("%.3f", min(runs)), "\\n")
        R
        out, err, st = boot(executable, ["-e", compute_probe], { "TEBAKO_RUNTIME_IMAGE" => image })
        expect_ok("compute-floor", out, err, st, "COMPUTE-FLOOR")
        out = out.delete("\r")
        puts "     compute-floor: the #{COMPUTE_LOOP_N}-iteration loop #{out[/^runs: (.+)$/, 1]}"
        # R's cat() separates every argument pair with a space, so the
        # "best:" line ends in one ("best: 0.300 \n") — allow the
        # trailing whitespace.
        best = out[/^best: (\d+(?:\.\d+)?)\s*$/, 1]&.to_f
        floor = "compute-floor: the #{COMPUTE_LOOP_N}-iteration loop best-of-#{COMPUTE_RUNS} under " \
                "#{COMPUTE_FLOOR_SECONDS}s"
        detail = "measured best #{best.inspect}s (runs in the log above) — a leg computing at a fraction " \
                 "of the matrix's rate is a slow BUILD, never a publishable artifact " \
                 "(tebako-runtime-python#79's lesson)\nstdout: #{out}\nstderr: #{err}"
        if best.nil? || best > COMPUTE_FLOOR_SECONDS
          if COMPUTE_FLOOR_MODE == "warn"
            # The warn tier (the header block + the mode comment): the
            # defect is LIVE on this leg's class, the root cause is the
            # product repo's — the measurement and a workflow-command
            # warning carry it, the leg stays green.
            puts "::warning title=compute-floor::the #{COMPUTE_LOOP_N}-iteration loop best #{best.inspect}s past the " \
                 "#{COMPUTE_FLOOR_SECONDS}s tripwire — the live tebako#1095 slow-compute defect on real " \
                 "Intel silicon; this leg rides warn-only until tebako#1095 closes"
            puts "warn #{floor}: #{detail}"
          else
            check(floor, false, detail)
          end
        else
          check(floor, true, detail)
        end
      when "bad-mount"
        missing = File.join(dir, "no-such-image.tfs")
        out, err, st = boot(executable,
                            ["--tebako-image", "#{missing}:-:/nope", "--tebako-entry", "/nope/x.R"],
                            { "TEBAKO_RUNTIME_IMAGE" => image })
        expect_exit("bad-mount", out, err, st, 69)
        check("bad-mount: the image is named", err.include?(missing), "stderr: #{err}")
      when "mount-root-override"
        override = File.join(dir, "override-root")
        # R_HOME follows the override (the fs TU reads the driver's
        # validated TEBAKO_MOUNT_ROOT), so the card reads via R.home():
        # <override>/lib/R up two is the override root.
        probe = <<~R
          root <- dirname(dirname(R.home()))
          cat("BOOT-OK\\n")
          cat("home:", R.home(), "\\n")
          cat("card:", file.exists(file.path(root, "lib", "tebako", "layout.yaml")), "\\n")
        R
        out, err, st = boot(executable, ["-e", probe],
                            { "TEBAKO_RUNTIME_IMAGE" => image, "TEBAKO_MOUNT_ROOT" => override })
        expect_ok("mount-root-override", out, err, st, "BOOT-OK")
        check("mount-root-override: R_HOME follows the override root",
              out.include?("home: #{override}/lib/R"), "stdout: #{out}\nstderr: #{err}")
        check("mount-root-override: the card reads at the override root", out.include?("card: TRUE"),
              "stdout: #{out}\nstderr: #{err}")
      when "mount-root-malformed"
        out, err, st = boot(executable, ["--version"],
                            { "TEBAKO_RUNTIME_IMAGE" => image, "TEBAKO_MOUNT_ROOT" => "relative/path" })
        expect_exit("mount-root-malformed", out, err, st, 65)
        check("mount-root-malformed: the variable is named", err.include?("TEBAKO_MOUNT_ROOT"), "stderr: #{err}")
      when "override-ungranted"
        fixture = ungranted_fixture(tfs, dir, platform)
        out, err, st = boot(executable, ["--version"],
                            { "TEBAKO_RUNTIME_IMAGE" => fixture, "TEBAKO_MOUNT_ROOT" => File.join(dir, "elsewhere") })
        expect_exit("override-ungranted", out, err, st, 78)
      end
    end
  end
end

executable = resolve_executable(options[:runtime_root], options[:exe])
puts "-- Boot smoke: #{executable} (#{platform.host_id})"
selected = selected_scenarios(options[:scenario])
tfs = (selected & TFS_SCENARIOS).any? ? resolve_tfs(options[:tfs]) : nil
run_scenarios(executable, platform, selected, tfs: tfs)

if $failures.positive?
  puts "#{$failures} scenario check(s) failed"
  exit 143
end
puts "boot smoke: all green"
exit 0
